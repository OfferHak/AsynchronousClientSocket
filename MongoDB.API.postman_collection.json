              "raw": "{{baseUrl}}/api/signalrclients/unregister/{{connectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "signalrclients", "unregister", "{{connectionId}}"]
            }
          }
        },
        {
          "name": "Update Client Activity",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/signalrclients/activity/{{connectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "signalrclients", "activity", "{{connectionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Health & Info",
      "item": [
